<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:Npp.FlyfishFileViewer;assembly=Npp.FlyfishFileViewer"
        x:Class="Avalonia.FileViewer.Demo.MainWindow"
        Title="Avalonia.FileViewer — 多格式文件预览" Width="1280" Height="840"
        MinWidth="800" MinHeight="540">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="16,12" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <Button Content="打开文件…" Click="OnOpenFiles" />
        <Button Grid.Column="1" Content="重新加载" Click="OnReload" Margin="8,0,0,0" />
        <Button Grid.Column="2" Content="清空列表" Click="OnClear" Margin="8,0,0,0" />
        <TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                   Text="Flyfish · 本地预览 · 文件不会上传" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="260,*">
      <Border Background="#F6F7F9" Padding="12" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="文件列表" FontWeight="SemiBold" Margin="4,0,0,12" />
          <ListBox x:Name="Files" Grid.Row="1" SelectionChanged="OnFileSelected" />
          <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="4,12,4,0" Foreground="#666666"
                     Text="内置 DOCX / PPTX / XLSX / PPT 示例。也可选择 PDF、图片、文本、音视频等文件；实际支持以已打包的渲染器为准。旧 PPT 保留上游水印。" />
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <viewer:FlyfishFileViewer x:Name="Preview" />
        <TextBlock x:Name="EmptyHint" Text="点击“打开文件”或选择左侧示例开始预览"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666" />
      </Grid>
    </Grid>
    <Border Grid.Row="2" Padding="16,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
      <TextBlock x:Name="Status" Text="就绪" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
